# MQTT odbierany przez backend
MQTT_HOST=your-cluster.s1.eu.hivemq.cloud
MQTT_PORT=8883
MQTT_TOPIC=production/sensor/all
MQTT_CLIENT_ID=esp32-sensor-backend
MQTT_DEVICE_ID=esp32-1
MQTT_USERNAME_SERVER=your-backend-mqtt-username
MQTT_PASSWORD_SERVER=your-backend-mqtt-password

# MQTT używany przez lokalny generator
MQTT_USERNAME=your-generator-mqtt-username
MQTT_PASSWORD=your-generator-mqtt-password

# Baza danych (hasło jest używane przez Docker Compose)
POSTGRES_PASSWORD=change-this-database-password
# DATABASE_URL=postgresql://sensor_app:change-this-database-password@localhost:5432/sensor_system
APP_TIMEZONE=Europe/Warsaw

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# OPENAI_VECTOR_STORE_ID=vs_...

# Aplikacja
SECRET_KEY=change-me
FLASK_DEBUG=false
THRESHOLDS_FILE=data/thresholds.json
